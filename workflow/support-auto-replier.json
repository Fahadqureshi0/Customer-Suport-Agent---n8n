    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nlet text = \"\";\n\nfor (const row of rows) {\n  text = text + \"Category: \" + row.json.Category + \"\\n\";\n  text = text + \"Q: \" + row.json.Question + \"\\n\";\n  text = text + \"A: \" + row.json.Answer + \"\\n\\n\";\n}\n\nreturn [{ json: { faq_text: text } }];"
      },
